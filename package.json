{
  "name": "devbox",
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://dicksonmaina.github.io/devbox",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "analyze": "node scripts/analyze.cjs",
    "agent": "node scripts/agent.cjs",
    "discover": "node scripts/discover.cjs",
    "strategy": "node scripts/strategy.cjs",
    "implement": "node scripts/implement.cjs",
    "pipeline": "node scripts/pipeline.cjs",
    "auto": "node scripts/pipeline.cjs --auto --limit 1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
